# ==============================================================================
# IOPHIN Environment Configuration
# Copy this file to .env and fill in your credentials
# ==============================================================================

# --- Database ---
# PostgreSQL connection string (required for production)
DATABASE_URL=postgresql://iophin_user:your_password@localhost:5432/iophin_db

# Use database mode (set to false for static file fallback)
USE_DATABASE=true

# --- ACLED Conflict Data API ---
# Sign up at https://acleddata.com/register/
ACLED_EMAIL=your_email@example.com
ACLED_PASSWORD=your_acled_password

# --- Google Earth Engine (VIIRS Nightlights + NDVI + Rainfall) ---
# Option A: Service account (recommended for production)
GEE_SERVICE_ACCOUNT=your-service-account@project.iam.gserviceaccount.com
GEE_KEY_FILE=gee/your-key-file.json

# Option B: Default credentials (run `earthengine authenticate` first)
# Leave GEE_SERVICE_ACCOUNT and GEE_KEY_FILE empty to use default auth

# --- HDX / Humanitarian Data Exchange ---
# GRID3 Nigeria datasets (health facilities, education, population)
# No API key needed — public downloads via CKAN API
# Base URL for the HDX CKAN API
HDX_API_URL=https://data.humdata.org/api/3/action

# --- WorldPop Population Data ---
# No API key needed — public REST API
WORLDPOP_API_URL=https://www.worldpop.org/rest/data

# --- IOM Displacement Tracking Matrix (IDP data) ---
# Primary: Live DTM API v3 (requires subscription key from https://dtmapi.iom.int)
DTM_API_URL=https://dtmapi.iom.int/api
DTM_API_KEY=your_dtm_api_subscription_key_here
# Fallback 1: NE Baseline Assessment XLSX (Round 43) — site-level data for 6 NE states
#   See: https://data.humdata.org/dataset/nigeria-baseline-data-iom-dtm
DTM_NE_BASELINE_XLSX_URL=https://data.humdata.org/dataset/4adf7874-ae01-46fd-a442-5fc6b3c9dff1/resource/3128e7b0-ba3f-4486-8c49-863544c92a69/download
# Fallback 2: NC&W Baseline Assessment XLSX (Round 13) — site-level for 8 NC&W states
#   See: https://data.humdata.org/dataset/nigeria-displacement-data-north-central-west-baeline-assessment-iom-dtm
DTM_NCW_BASELINE_XLSX_URL=https://data.humdata.org/dataset/nigeria-displacement-data-north-central-west-baeline-assessment-iom-dtm/resource/3c121436-96d1-4f64-a419-2fa437a08dbe/download
# Fallback 3: Summary CSV — covers extra states (Cross River, FCT, Jigawa, Kogi, Niger)
#   See: https://data.humdata.org/dataset/nigeria-iom-displacement-tracking-matrix-dtm-from-api
DTM_HDX_CSV_URL=https://data.humdata.org/dataset/2bec769a-7326-4a5c-83ca-7d32ffabcf5e/resource/54650b1f-d409-4ba0-b171-9206d92eded5/download

# --- WFP VAM Food Prices ---
# Public API — no key needed
WFP_API_URL=https://api.vam.wfp.org/dataviz/api

# --- OpenStreetMap / Geofabrik (Road Network) ---
# No API key needed — Overpass API for road queries
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# --- Server Configuration ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Scheduler Intervals (in hours) ---
SCHEDULER_CONFLICT_INTERVAL=1
SCHEDULER_VIIRS_INTERVAL=24
SCHEDULER_INFRASTRUCTURE_INTERVAL=6
SCHEDULER_ML_RETRAIN_INTERVAL=12
SCHEDULER_GRID3_INTERVAL=168
SCHEDULER_NDVI_INTERVAL=24
SCHEDULER_RAINFALL_INTERVAL=24
SCHEDULER_POPULATION_INTERVAL=720
SCHEDULER_IDP_INTERVAL=168
SCHEDULER_FOOD_PRICE_INTERVAL=168
